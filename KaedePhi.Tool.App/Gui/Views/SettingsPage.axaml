<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KaedePhi.Tool.App.Gui.ViewModels"
             xmlns:loc="using:KaedePhi.Tool.Localization"
             x:Class="KaedePhi.Tool.App.Gui.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <Grid Margin="34,26" ColumnDefinitions="240,*" RowDefinitions="*,Auto,Auto" ColumnSpacing="24">
        <StackPanel Grid.RowSpan="3" Grid.Column="0" Spacing="16">
            <TextBlock Text="{x:Static loc:GuiLocalizationString.ui_settings_eyebrow}" Classes="eyebrow" />
            <TextBlock Text="{x:Static loc:GuiLocalizationString.settings_title}" Classes="page-title" FontSize="27" />
            <TextBlock Text="{x:Static loc:GuiLocalizationString.ui_settings_desc}"
                       Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <Border Classes="card" Padding="16" Margin="0,8,0,0">
                <StackPanel Spacing="11">
                    <TextBlock Text="{x:Static loc:GuiLocalizationString.ui_settings_hint_title}" Classes="section-title" />
                    <TextBlock Text="{x:Static loc:GuiLocalizationString.ui_settings_hint_desc}"
                               Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <Border Background="{DynamicResource AccentDimBrush}" CornerRadius="0" Padding="10">
                        <TextBlock Text="{x:Static loc:GuiLocalizationString.ui_settings_hint_saved}"
                                   Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="0" Grid.Column="1" Classes="card" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    <!-- 标题 -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xf013;" Classes="fa-icon"
                                   FontSize="24" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static loc:GuiLocalizationString.settings_title}" FontSize="22"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 通用 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static loc:GuiLocalizationString.settings_max_log_files}" FontSize="12"
                                   Opacity="0.7" />
                        <NumericUpDown Value="{Binding Draft.MaxLogFiles}" Minimum="1" Maximum="100"
                                       Increment="1" FormatString="F0" Width="200" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Unbind -->
                    <Expander Header="{x:Static loc:GuiLocalizationString.settings_unbind}">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Static loc:GuiLocalizationString.option_precision}" FontSize="12"
                                           Opacity="0.7" />
                                <TextBox Text="{Binding Unbind.Precision}" Width="200" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Static loc:GuiLocalizationString.option_tolerance}" FontSize="12"
                                           Opacity="0.7" />
                                <NumericUpDown Value="{Binding Unbind.Tolerance}" Minimum="0" Maximum="100"
                                               Increment="0.1" FormatString="F2" Width="200" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Static loc:GuiLocalizationString.option_unbind_merge_tolerance}"
                                           FontSize="12" Opacity="0.7" />
                                <NumericUpDown Value="{Binding Unbind.MergeTolerance}" Minimum="0" Maximum="100"
                                               Increment="0.1" FormatString="F2" Width="200" HorizontalAlignment="Left" />
                            </StackPanel>
                            <CheckBox Content="{x:Static loc:GuiLocalizationString.option_classic_mode}"
                                      IsChecked="{Binding Unbind.ClassicMode}" />
                            <CheckBox Content="{x:Static loc:GuiLocalizationString.option_disable_compress}"
                                      IsChecked="{Binding Unbind.DisableCompress}"
                                      IsEnabled="{Binding Unbind.DisableCompressEnabled}"
                                      ToolTip.Tip="{x:Static loc:GuiLocalizationString.option_disable_compress_hint}" />
                        </StackPanel>
                    </Expander>

                    <!-- 层级合并 -->
                    <Expander Header="{x:Static loc:GuiLocalizationString.settings_layermerge}">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Static loc:GuiLocalizationString.option_precision}" FontSize="12"
                                           Opacity="0.7" />
                                <TextBox Text="{Binding LayerMerge.Precision}" Width="200" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Static loc:GuiLocalizationString.option_tolerance}" FontSize="12"
                                           Opacity="0.7" />
                                <NumericUpDown Value="{Binding LayerMerge.Tolerance}" Minimum="0" Maximum="100"
                                               Increment="0.1" FormatString="F2" Width="200" HorizontalAlignment="Left" />
                            </StackPanel>
                            <CheckBox Content="{x:Static loc:GuiLocalizationString.option_classic_mode}"
                                      IsChecked="{Binding LayerMerge.ClassicMode}" />
                            <CheckBox Content="{x:Static loc:GuiLocalizationString.option_disable_compress}"
                                      IsChecked="{Binding LayerMerge.DisableCompress}"
                                      IsEnabled="{Binding LayerMerge.DisableCompressEnabled}"
                                      ToolTip.Tip="{x:Static loc:GuiLocalizationString.option_disable_compress_hint}" />
                        </StackPanel>
                    </Expander>

                    <!-- 切割 -->
                    <Expander Header="{x:Static loc:GuiLocalizationString.settings_cut}">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Static loc:GuiLocalizationString.option_precision}" FontSize="12"
                                           Opacity="0.7" />
                                <TextBox Text="{Binding Cut.Precision}" Width="200" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Static loc:GuiLocalizationString.option_tolerance}" FontSize="12"
                                           Opacity="0.7" />
                                <NumericUpDown Value="{Binding Cut.Tolerance}" Minimum="0" Maximum="100"
                                               Increment="0.1" FormatString="F2" Width="200" HorizontalAlignment="Left" />
                            </StackPanel>
                            <CheckBox Content="{x:Static loc:GuiLocalizationString.option_disable_compress}"
                                      IsChecked="{Binding Cut.DisableCompress}" />
                        </StackPanel>
                    </Expander>

                    <!-- 拟合 -->
                    <Expander Header="{x:Static loc:GuiLocalizationString.settings_fit}">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Static loc:GuiLocalizationString.option_tolerance}" FontSize="12"
                                           Opacity="0.7" />
                                <NumericUpDown Value="{Binding Draft.Fit.Tolerance}" Minimum="0" Maximum="100"
                                               Increment="0.5" FormatString="F1" Width="200" HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- 渲染 -->
                    <Expander Header="{x:Static loc:GuiLocalizationString.settings_render}">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_pixels_per_beat}"
                                               FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Render.PixelsPerBeat}" Minimum="10" Maximum="1000"
                                                   Increment="10" FormatString="F0" Width="140" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_channel_width}"
                                               FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Render.ChannelWidth}" Minimum="50" Maximum="1000"
                                                   Increment="10" FormatString="F0" Width="140" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_samples_per_event}"
                                               FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Render.SamplesPerEvent}" Minimum="4" Maximum="1024"
                                                   Increment="4" FormatString="F0" Width="140" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_beat_subdivisions}"
                                               FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Render.BeatSubdivisions}" Minimum="1" Maximum="16"
                                                   Increment="1" FormatString="F0" Width="140" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_range_padding_ratio}"
                                               FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Render.RangePaddingRatio}" Minimum="0" Maximum="1"
                                                   Increment="0.01" FormatString="F3" Width="140" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_range_samples}"
                                               FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Render.RangeSamplesPerEvent}" Minimum="1"
                                                   Maximum="1024"
                                                   Increment="1" FormatString="F0" Width="140" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="{x:Static loc:GuiLocalizationString.option_segment_group_tolerance}"
                                        FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Render.SegmentGroupTolerance}" Minimum="0"
                                                   Maximum="1"
                                                   Increment="0.000001" FormatString="F7" Width="140" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_min_value_range_half}"
                                               FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Render.MinValueRangeHalf}" Minimum="0" Maximum="100"
                                                   Increment="0.01" FormatString="F3" Width="140" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="{x:Static loc:GuiLocalizationString.option_min_value_range_half_ratio}"
                                    FontSize="12" Opacity="0.7" />
                                <NumericUpDown Value="{Binding Draft.Render.MinValueRangeHalfRatio}" Minimum="0" Maximum="1"
                                               Increment="0.01" FormatString="F3" Width="200"
                                               HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- 转换 -->
                    <Expander Header="{x:Static loc:GuiLocalizationString.settings_convert}">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <!-- PE 选项 -->
                            <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_pe_options}" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,4,0,0" />
                            <StackPanel Spacing="6">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_easing_precision}"
                                               FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding Draft.Convert.PeUnsupportedEasingPrecision}" Width="200"
                                             HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_alpha_precision}"
                                               FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding Draft.Convert.PeAlphaCutPrecision}" Width="200"
                                             HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_alpha_tolerance}"
                                               FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Convert.PeAlphaCutTolerance}" Minimum="0"
                                                   Maximum="100"
                                                   Increment="0.01" FormatString="F3" Width="200"
                                                   HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_speed_precision}"
                                               FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding Draft.Convert.PeSpeedCutPrecision}" Width="200"
                                             HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>

                            <!-- PhigrosV3 选项 -->
                            <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_phigros_options}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <StackPanel Spacing="6">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_easing_precision}"
                                               FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding Draft.Convert.PhigrosEasingPrecision}" Width="200"
                                             HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_alpha_precision}"
                                               FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding Draft.Convert.PhigrosAlphaCutPrecision}" Width="200"
                                             HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 通用选项 -->
                            <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_common_options}" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,4,0,0" />

                            <StackPanel Spacing="6">
                                <CheckBox Content="{x:Static loc:GuiLocalizationString.convert_stream_import}"
                                          IsChecked="{Binding Draft.Convert.StreamImport}" />
                                <CheckBox Content="{x:Static loc:GuiLocalizationString.convert_stream_output}"
                                          IsChecked="{Binding Draft.Convert.StreamOutput}" />
                            </StackPanel>

                            <!-- 解绑 -->
                            <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_unbind_section}" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,4,0,0" />
                            <StackPanel Spacing="6">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_unbind_precision}"
                                               FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding Draft.Convert.UnbindPrecision}" Width="200"
                                             HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_unbind_tolerance}"
                                               FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Convert.UnbindTolerance}" Minimum="0" Maximum="100"
                                                   Increment="0.01" FormatString="F3" Width="200"
                                                   HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="{x:Static loc:GuiLocalizationString.convert_unbind_merge_tolerance}"
                                        FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Convert.UnbindMergeTolerance}" Minimum="0"
                                                   Maximum="100"
                                                   Increment="0.01" FormatString="F3" Width="200"
                                                   HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Content="{x:Static loc:GuiLocalizationString.convert_unbind_classic}"
                                          IsChecked="{Binding Draft.Convert.UnbindClassicMode}" />
                            </StackPanel>

                            <!-- 合并 -->
                            <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_merge_section}" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,4,0,0" />
                            <StackPanel Spacing="6">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_merge_precision}"
                                               FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding Draft.Convert.MultiLayerMergePrecision}" Width="200"
                                             HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_merge_tolerance}"
                                               FontSize="12" Opacity="0.7" />
                                    <NumericUpDown Value="{Binding Draft.Convert.MultiLayerMergeTolerance}" Minimum="0"
                                                   Maximum="100"
                                                   Increment="0.01" FormatString="F3" Width="200"
                                                   HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Content="{x:Static loc:GuiLocalizationString.convert_merge_classic}"
                                          IsChecked="{Binding Draft.Convert.MultiLayerMergeClassicMode}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="1" Grid.Column="1" Padding="16,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" />
        </Border>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Grid.Column="1" Padding="16,12"
                Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Classes="secondary" Click="OnReturnClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xf060;" Classes="fa-icon"
                                   FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static loc:GuiLocalizationString.btn_back}" />
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Click="OnResetClick">
                    <TextBlock Text="{x:Static loc:GuiLocalizationString.btn_reset_defaults}" />
                </Button>
                <Button Classes="primary" FontSize="14" Click="OnSaveClick">
                    <TextBlock Text="{x:Static loc:GuiLocalizationString.btn_save_settings}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
